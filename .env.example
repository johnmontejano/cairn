# Cairn configuration.
#
# Copy to `.env.local` (or let `pnpm setup` create it) and fill in only what you
# want to turn on. Every value here is a placeholder — never commit a real one.
#
# Nothing in this file is exposed to the browser: no variable is prefixed
# NEXT_PUBLIC_, and the server is the only reader.

# ---------------------------------------------------------------- core ----

# demo = works with no external accounts. cloud = hosted providers configured.
CAIRN_MODE=demo
CAIRN_APP_URL=http://localhost:3000
CAIRN_LOCAL_DATA_DIR=.cairn
LOG_LEVEL=info

# ------------------------------------------------------ encryption keys ----

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this makes every workspace key — and therefore every memory encrypted
# under it — permanently unreadable. Keep it in a secret manager in production.
CAIRN_MASTER_KEY=replace-with-32-random-bytes-base64
CAIRN_MASTER_KEY_VERSION=v1

# `env` reads the key above. `kms` calls an external key service instead and
# requires a KMS client to be registered at start-up (see docs/DEPLOYMENT.md).
CAIRN_KEY_PROVIDER=env
# CAIRN_KMS_KEY_ID=arn:aws:kms:region:account:key/replace-me

# ------------------------------------------------------------- database ----

# Leave unset to use the local single-process PostgreSQL that ships with the
# project. Set it to run against Supabase or any PostgreSQL with pgvector.
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true

# ------------------------------------------------------- authentication ----

# fixture = local sign-in, the code is printed to the server log.
# workos   = WorkOS AuthKit (email code and Google).
AUTH_PROVIDER=fixture
# WORKOS_API_KEY=sk_test_replace_me
# WORKOS_CLIENT_ID=client_replace_me
# WORKOS_REDIRECT_URI=http://localhost:3000/api/oauth/workos/callback
# CAIRN_SESSION_SECRET=replace-with-at-least-32-random-characters

# ------------------------------------------------------------------- AI ----

# fixture = the built-in reader. Deterministic, free, nothing leaves the machine.
# openai  = OpenAI Responses + embeddings, called with store:false.
# local   = any OpenAI-compatible endpoint you run yourself.
AI_PROVIDER=fixture
# OPENAI_API_KEY=sk-replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACTION_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_EXTRACTION_MODEL=llama3.1
# LOCAL_AI_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------- storage and the queue ----

# local    = encrypted blobs in the database.
# supabase = encrypted blobs in a Supabase Storage bucket.
STORAGE_PROVIDER=local
# SUPABASE_URL=https://replace-me.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key
SUPABASE_STORAGE_BUCKET=cairn-raw-sources

# postgres = the durable job table in this database (works on Supabase too).
# supabase = Supabase Queues (pgmq).
QUEUE_PROVIDER=postgres
CAIRN_QUEUE_NAME=cairn_jobs

# ----------------------------------------------------------- connectors ----

# Google Drive, read-only (drive.readonly and nothing else).
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# GitHub App, read-only, plus the optional memory mirror.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=replace-me
# GITHUB_CLIENT_ID=Iv1.replace_me
# GITHUB_CLIENT_SECRET=replace-me
# GITHUB_REDIRECT_URI=http://localhost:3000/api/oauth/github/callback

# ------------------------------------------------- scheduled refresh ----

# Shared secret the scheduler presents to /api/cron/sync as a bearer token.
# Set it and connected apps refresh on their own; leave it unset and the
# endpoint refuses every caller and the interface keeps saying that nothing
# runs on its own. On Vercel, adding a CRON_SECRET project variable makes Cron
# send it automatically; the schedule itself lives in vercel.json.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=replace-me

# ------------------------------------------------------------------ MCP ----

# local = the connection code created in Settings → Connected AIs.
# oauth = OAuth 2.1 bearer tokens verified against the issuer below.
MCP_AUTH_MODE=local
# MCP_OAUTH_ISSUER=https://your-tenant.authkit.app
# MCP_OAUTH_JWKS_URL=https://your-tenant.authkit.app/oauth2/jwks
# MCP_OAUTH_AUDIENCE=https://your-app.example.com/api/mcp

# ------------------------------------------------ limits and monitoring ----

CAIRN_AI_MONTHLY_BUDGET_USD=5
CAIRN_AI_SOFT_LIMIT_RATIO=0.8
CAIRN_MAX_UPLOAD_BYTES=10485760
CAIRN_MAX_EXTRACTION_CHARS=24000

# Allows http:// and private-address URL imports. Tests only — never in production.
CAIRN_ALLOW_INSECURE_URL_IMPORT=false

# SENTRY_DSN=https://replace@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
