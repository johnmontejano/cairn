{
  "name": "cairn",
  "private": true,
  "version": "0.1.0",
  "description": "Cairn \u2014 one private, durable memory shared by the AI tools you authorize.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter @cairn/web dev",
    "dev:worker": "pnpm --filter @cairn/worker dev",
    "dev:all": "node scripts/dev-all.mjs",
    "db:reset": "node --import tsx packages/db/src/cli/reset.ts",
    "db:migrate": "node --import tsx packages/db/src/cli/migrate.ts",
    "demo:seed": "node --import tsx scripts/seed-demo.mts",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,md,css}\"",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:mcp": "vitest run --project mcp",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "build": "pnpm --filter @cairn/web build",
    "verify": "node scripts/verify.mjs",
    "mcp:stdio": "node --import tsx packages/mcp/src/bin/stdio.ts"
  },
  "devDependencies": {
    "@cairn/config": "workspace:*",
    "@cairn/connectors": "workspace:*",
    "@cairn/crypto": "workspace:*",
    "@cairn/db": "workspace:*",
    "@cairn/domain": "workspace:*",
    "@cairn/ingestion": "workspace:*",
    "@cairn/mcp": "workspace:*",
    "@cairn/search": "workspace:*",
    "@cairn/testing": "workspace:*",
    "@cairn/ui": "workspace:*",
    "@cairn/vault": "workspace:*",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.0",
    "@types/node": "20.19.9",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
