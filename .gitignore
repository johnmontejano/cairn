node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
.turbo/

# Local runtime state (never commit)
# Per-machine Codex config. Keep MCP servers in ~/.codex/config.toml only:
# a project-local server with the same name as a global one merges key-by-key
# and produces an invalid entry (e.g. `command` + `url` on one stdio server).
.codex/
.env
.env.local
.env.*.local
.cairn/
.cairn-e2e/
*.local.json

# Built project page (regenerated by site/build.mjs)
site/dist/

# Test output
test-results/
playwright-report/
blob-report/
.playwright/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Never commit exports or backups produced locally. Anchored to the root:
# the app has a legitimate route folder at apps/web/src/app/exports.
/exports/
backups/
tmp/
# Generated by Next and by tooling caches
next-env.d.ts

# Impeccable: the shared detector config is tracked; the cache and the
# per-developer overrides are not.
.impeccable/hook.cache.json
.impeccable/config.local.json
design-review/
.vercel

# Local visual-verification captures; proof for a session, not source.
artifacts/
