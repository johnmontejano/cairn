{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/.next", "apps/web", "packages/ui"]
}
